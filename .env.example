# ╔══════════════════════════════════════════════════════════════╗
# ║         Patreon Creator Skill — Environment Variables        ║
# ╚══════════════════════════════════════════════════════════════╝

# ── REQUIRED ────────────────────────────────────────────────────
# Creator Access Token from https://www.patreon.com/portal/registration/register-clients
# This token has full read access to your campaign data.
PATREON_ACCESS_TOKEN=

# ── OPTIONAL: LLM for autonomous preprocessing ──────────────────
# If not set, tools return structured prompts for your agent's model.
# Configure only if you want the skill to call an LLM autonomously
# for batch tasks (e.g., sentiment analysis on 100+ comments).
#
# Examples:
#   Ollama (local):     LLM_BASE_URL=http://localhost:11434
#   LM Studio (local):  LLM_BASE_URL=http://localhost:1234/v1
#   OpenAI:             LLM_BASE_URL=https://api.openai.com/v1
#   OpenClaw:           LLM_BASE_URL=https://your-openclaw-endpoint
LLM_BASE_URL=
LLM_MODEL=hermes3
LLM_API_KEY=

# ── OPTIONAL: Competitor Intelligence ───────────────────────────
# Google Custom Search API
# Setup: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Microsoft Bing Web Search API
# Setup: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=

# ── OPTIONAL: Browser Automation (Playwright) ───────────────────
# Required for: posts_publish_via_browser, comments_bulk_respond
# The skill creates a persistent browser session to avoid re-login.
PATREON_EMAIL=
PATREON_PASSWORD=

# Headless mode (true = no browser window, recommended for servers)
BROWSER_HEADLESS=true

# ── OPTIONAL: Storage Paths ─────────────────────────────────────
# Where to store the local knowledge base (ChromaDB)
KNOWLEDGE_BASE_PATH=~/.patreon/knowledge_base

# Where to store browser session data (avoids re-login)
BROWSER_SESSION_PATH=~/.patreon/browser_session
